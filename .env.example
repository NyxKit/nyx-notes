# Copy this file to .env and adjust to your local setup.
# Source it before running the server or CLI:
#   source .env   (bash/zsh)
#   export (cat .env)   (fish)

NOTES_ROOT=/tmp/nyx-notes
NOTES_USER_ID=local

# Server
PORT=8080
AUTH_MODE=local

# Optional frontend dev override when not proxying to localhost:$PORT
# VITE_API_PROXY_TARGET=http://localhost:8080

# Optional — secret_key mode
# AUTH_MODE=secret_key
# NOTES_ADMIN_PASSWORD=changeme
